{% import "_macros.html.j2" as macros %}

<!DOCTYPE html>
<html lang="en">

  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CSU Esports Attendance Tracker</title>
    <link rel="stylesheet" href="/static/style.css">
  </head>

  <body>

    <!-- ── HEADER ─────────────────────────────────────────────────────────── -->
    <header class="csu-header">
      <div class="header-brand">
        <div class="header-logo">
          <img src="/static/CSUVikingLogo.avif" alt="CSU Vikings Logo" class="logo-img">
        </div>
        <div class="header-text">
          <span class="university-name">Cleveland State University</span>
          <span class="app-subtitle">Esports Attendance Tracker</span>
        </div>
      </div>
      <button id="btn-register-open" class="btn-outline-gold">Register Student</button>
    </header>

    <!-- ── TAB NAV ────────────────────────────────────────────────────────── -->
    <nav class="tab-nav">
      {% for tab in tabs %}
      <button type="button" class="tab-btn {{ 'active' if loop.first else ''}}" data-tab="{{ tab.id }}"
        aria-controls="tab-{{ tab.id }}" aria-selected="{{ 'true' if loop.first else 'false' }}">{{ tab.label }}
      </button>
      {% endfor %}
    </nav>

    <main class="main-content">

      <!-- ── ATTENDANCE TAB ─────────────────────────────────────────────── -->
      <section id="tab-attendance" class="tab-panel">

        <div class="card scan-card">
          <h2 class="card-title">Scan ID</h2>
          <form method="post" action="{{ url_for('log_visit')}}">
            {{ scan_form.hidden_tag() }}

            {{ scan_form.scan_id(
                class="scan-input",
                placeholder="Scan or enter student ID...",
                autocomplete="off",
                autofocus=True,
            )}}

            {{ scan_form.submit() }}
          </form>
        </div>

        <div class="two-col">
          <div class="card scan-log-card">
            <h2 class="card-title">Scan Log</h2>
            <ul id="scan-log-list" class="scan-log-list">
              {% if not scan_log %}
              <li class="empty-state">No scans yet today</li>
              {% else %}
              {% for scan in scan_log %}
              {# #TODO: log-entry-registered/unknown should be decided outside of here? #}
              {# Can replace class="" with jinja var and scan var with scan.text_content or smth #}
              <li class="log-entry-registered">{{ scan }}</li>
              {% endfor %}
              {% endif %}
            </ul>
          </div>
          <div class="card attendance-card">
            <h2 class="card-title">Today's Attendance</h2>
            <p id="attendance-count" class="big-count">{{ scan_log|length }}</p>
            <p class="big-count-label">Students</p>
          </div>
        </div>

      </section>

      <!-- ── GEAR CHECKOUT TAB ──────────────────────────────────────────── -->
      <section id="tab-gear" class="tab-panel hidden">
        <div class="gear-header-row">
          <div>
            <h2 class="gear-title">Gear Checkout System</h2>
            <p class="gear-subtitle">Track keyboards, mice, mousepads, and other equipment</p>
          </div>
          <button id="btn-checkout-open" class="btn-dark-green">Check Out Gear</button>
        </div>

        <div class="stat-cards-row">
          <div class="stat-card">
            {# #XXX: Might want to reconsider passing the class #}
            <span class="stat-label">Total Checked Out</span>
            <span id="stat-total" class="stat-number">{{ gear_stats.total }}</span>
          </div>
          <div class="stat-card">
            <span class="stat-label">Keyboards</span>
            <span id="stat-keyboards" class="stat-number">{{ gear_stats.keyboards }}</span>
          </div>
          <div class="stat-card">
            <span class="stat-label">Mice</span>
            <span id="stat-mice" class="stat-number">{{ gear_stats.mice }}</span>
          </div>
          <div class="stat-card">
            <span class="stat-label">Other Gear</span>
            <span id="stat-other" class="stat-number">{{ gear_stats.other_gear }}</span>
          </div>
        </div>

        <div class="card">
          <h2 class="card-title">Currently Checked Out</h2>
          <div id="checkout-empty" class="empty-state-block {{ 'hidden' if gear_checkouts else '' }}">
            No gear currently checked out
          </div>
          <table id="checkout-table" class="checkout-table {{ 'hidden' if not gear_checkouts else '' }}">
            <thead>
              <tr>
                <th>Student</th>
                <th>Gear Items</th>
                <th>Checkout Time</th>
                <th>Action</th>
              </tr>
            </thead>

            <tbody id="checkout-tbody">
              {% for row in gear_checkouts %}
              <tr>
                <td>{{ row.full_name }}</td>
                <td>{{ row["items"] | join(", ") }}</td>
                <td>{{ row.checkout_time }}</td>
                <td>
                  <button class="btn-return" data-checkout-id="{{ row.checkout_id }}" data-student="{{ row.full_name }}"
                    data-items="{{ row['items'] | join(', ') }}">
                    Return
                  </button>
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </section>

      <!-- ── HISTORY TAB ────────────────────────────────────────────────── -->
      <section id="tab-history" class="tab-panel hidden">
        <div class="card">
          <h2 class="card-title">Attendance History</h2>
          <div class="filter-row">
            <div class="form-group">
              <label for="hist-start">Start date</label>
              <input id="hist-start" type="date">
            </div>
            <div class="form-group">
              <label for="hist-end">End date</label>
              <input id="hist-end" type="date">
            </div>
            <button id="btn-history-load" class="btn-dark-green">Load</button>
          </div>
          <p id="history-summary" class="modal-hint" style="margin-top:0.75rem;"></p>
          <div id="history-empty" class="empty-state-block">Pick a date range and press Load.</div>
          <table id="history-table" class="checkout-table hidden">
            <thead>
              <tr>
                <th>Time</th>
                <th>Day</th>
                <th>Name</th>
                <th>Scanner ID</th>
                <th>Major</th>
              </tr>
            </thead>
            <tbody id="history-tbody"></tbody>
          </table>
        </div>
      </section>
    </main>

    {# Modal: Register Student #}
    <div id="modal-register" class="modal-overlay hidden" role="dialog" aria-modal="true">
      <div class="modal-box">
        <form action="{{ url_for('register_student') }}" method="post">
          <div class="modal-header">
            <h2 class="modal-title">Register Student</h2>
          </div>

          <div class="modal-body">
            {{ registration_form.hidden_tag() }}

            {{ macros.render_field(registration_form.full_name, "Brimstone") }}
            {{ macros.render_field(registration_form.csu_id, "1234567") }}
            {{ macros.render_field(registration_form.scan_id, "5 Digit number on back of ID") }}
            {{ macros.render_field(registration_form.major, "Computer Science") }}
            {{ macros.render_field(registration_form.grade, "") }}
          </div>

          <div class="modal-actions">
            {{ registration_form.submit(id="btn-register-submit", class="btn-dark-green") }}
            {{ registration_form.cancel(id="btn-register-cancel", class="btn-cancel") }}
          </div>
        </form>
      </div>
    </div>

    <script>
      // alert() can be used to get a popup message to the user.
    </script>
    <script src="/static/app.js"></script>
  </body>

</html>